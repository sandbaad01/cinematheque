{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cinémathèque",
  "version": "1.0.0",
  "identifier": "com.cinematheque.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:desktop",
    "frontendDist": "../src-tauri/html"
  },
  "app": {
    "windows": [
      {
        "title": "Cinémathèque",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "http://localhost:3000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/standalone/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
