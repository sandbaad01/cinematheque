{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cinémathèque",
  "version": "1.0.0",
  "identifier": "com.cinematheque.app",
  "build": {
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "frontendDist": "../out",
    "beforeBuildCommand": "echo 'Use tauri dev for development'"
  },
  "app": {
    "windows": [
      {
        "title": "Cinémathèque",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
